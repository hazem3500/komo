{
  "name": "komo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter komo-site build",
    "test": "pnpm --filter @hazem3500/komo test",
    "typecheck": "pnpm -r typecheck",
    "size": "pnpm --filter @hazem3500/komo size",
    "dev": "pnpm --filter komo-site dev",
    "dev:api": "pnpm --filter @hazem3500/komo dev:api",
    "deploy:site": "pnpm --filter komo-site run deploy",
    "deploy:api": "pnpm --filter @hazem3500/komo build:setup && wrangler deploy --config packages/komo/server/hosted.jsonc",
    "preview:deploy": "pnpm preview:site",
    "preview:site": "pnpm build && wrangler versions upload --config packages/komo-site/wrangler.jsonc --preview-alias \"$(git rev-parse --abbrev-ref HEAD | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')\""
  },
  "devDependencies": {
    "wrangler": "4.136.3",
    "prettier": "3.8.1"
  }
}
