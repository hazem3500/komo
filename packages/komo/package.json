{
  "name": "@tjcages/komo",
  "version": "0.7.0",
  "description": "Point, area, and threaded comments for website branches.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "server/index.ts",
    "server/validation.ts",
    "server/migrations",
    "server/tsconfig.json",
    "server/secrets.d.ts",
    "src/types.ts",
    "src/emoji.ts",
    "README.md",
    "NODE.md",
    "LICENSE",
    "src/page.ts",
    "NOTICE.md",
    "cli",
    "server/workspaces.ts",
    "server/setup-page.ts",
    "server/setup-client.txt",
    "server/project-management.ts",
    "server/webhooks.ts",
    "server/node-webhooks.ts",
    "server/import-project.ts",
    "server/digest.ts",
    "server/project-sites.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    },
    "./server": "./server/index.ts",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./node": {
      "import": "./dist/node.mjs"
    }
  },
  "sideEffects": [
    "./dist/chunk-*.js",
    "./dist/picker-*.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && pnpm run build:setup && pnpm run build:node",
    "prepack": "pnpm run build",
    "typecheck": "wrangler types --config server/wrangler.jsonc server/worker-configuration.d.ts && tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json",
    "test": "pnpm run build:setup && vitest run --config vitest.config.ts",
    "dev:api": "wrangler dev --config server/wrangler.jsonc --port 8788",
    "migrate:local": "wrangler d1 migrations apply DB --local --config server/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config server/wrangler.jsonc",
    "deploy:api": "pnpm run build:setup && wrangler deploy --config server/wrangler.jsonc",
    "build:setup": "esbuild src/setup-browser.ts --bundle --format=esm --minify --outfile=server/setup-client.txt",
    "size": "node scripts/measure.mjs",
    "bench": "node scripts/bench.mjs",
    "test:package": "pnpm run build && node scripts/check-package.mjs",
    "build:node": "esbuild server/node.ts --bundle --platform=node --format=esm --packages=external --loader:.txt=text --outfile=dist/node.mjs && mkdir -p dist/postgres && cp server/postgres/*.sql dist/postgres/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjcages/komo.git",
    "directory": "packages/komo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@untitledui/icons": "0.0.22",
    "emoji-picker-element": "^1.29.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.0",
    "motion": "^12.43.0",
    "react": "19.2.7",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.7",
    "terser": "5.44.0",
    "typescript": "^6.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  },
  "dependencies": {
    "emoji-regex": "^10.6.0",
    "pg": "^8.23.0"
  },
  "bin": {
    "komo": "./cli/index.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://komo.offbr.co",
  "bugs": {
    "url": "https://github.com/tjcages/komo/issues"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
